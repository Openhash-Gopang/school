---
 webapp.html | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/webapp.html b/webapp.html
index 2d3d866..cacb118 100644
--- a/webapp.html
+++ b/webapp.html
@@ -389,6 +389,21 @@ const SP_FALLBACK = `당신은 K-School AI 교수입니다. 고팡 생태계 교
 항상 격려하는 어조로, 핵심만 짧고 명확하게 설명합니다.`;
 const CFG = { systemPrompt: null };
 
+// ★ 2026-07-30 신설 — engine.js의 _gwpLaunch()가 보내는 facts(currentLocation)
+// 파싱. K-Public에서 같은 패턴으로 이미 적용·검증했다(주피터 지시 — gov
+// 도메인을 넘어 서비스 전반으로 확장). callDeepSeek는 이미 currentLocation을
+// 받으면 강제 주입하도록 되어 있으니(2026-07-30), 여기선 값만 보내면 된다.
+let GWP_FACTS = null;
+try {
+  const _qs = new URLSearchParams(location.search);
+  if (_qs.get('facts')) {
+    const raw = (_qs.get('facts_enc') === 'b64')
+      ? decodeURIComponent(escape(atob(_qs.get('facts'))))
+      : decodeURIComponent(_qs.get('facts'));
+    GWP_FACTS = JSON.parse(raw);
+  }
+} catch (e) { console.warn('[K-School] facts 파싱 실패(무시):', e.message); }
+
 async function loadSystemPrompt() {
   if (CFG.systemPrompt) return CFG.systemPrompt;
   try {
@@ -415,7 +430,7 @@ async function callAI(messages) {
       // callDeepSeek는 messages가 배열이면(항상 그렇다) 주입 텍스트를 messages 앞에만
       // 붙이고 별도 system 필드는 건드리지 않는다. 그 필드로 sp를 보내면 실제 DeepSeek
       // API가 top-level system 필드를 읽지 않아 K-School 고유 지시문이 조용히 유실된다.
-      body: JSON.stringify({ model:'deepseek-chat', service_id:'kedu', guid, messages:[{role:'system',content:sp}, ...messages.slice(-10)], max_tokens:2000 }),
+      body: JSON.stringify({ model:'deepseek-chat', service_id:'kedu', guid, messages:[{role:'system',content:sp}, ...messages.slice(-10)], max_tokens:2000, currentLocation: GWP_FACTS?.currentLocation || null }),
     });
     if (!r.ok) throw new Error(`proxy ${r.status}`);
     const d = await r.json();
-- 
