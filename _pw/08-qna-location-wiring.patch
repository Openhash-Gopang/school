 =?UTF-8?q?=EB=B0=B0=EC=84=A0=20=E2=80=94=20/ai/chat,=20/chat/completions?=
 =?UTF-8?q?=20=EC=96=91=EC=AA=BD=20=EC=97=B0=EA=B2=B0?=
