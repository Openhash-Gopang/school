-async function handleAIChat(bodyText,env,corsHeaders,meta=null){let body;try{body=JSON.parse(bodyText);}catch{return _err(400,'INVALID_JSON','Invalid JSON',corsHeaders);}const{provider='deepseek',model,system,messages,max_tokens=2000}=body;const builtMessages=[...(system?[{role:'system',content:system}]:[]),...(messages||[])];
+async function handleAIChat(bodyText,env,corsHeaders,meta=null){let body;try{body=JSON.parse(bodyText);}catch{return _err(400,'INVALID_JSON','Invalid JSON',corsHeaders);}const{provider='deepseek',model,system,messages,max_tokens=2000,currentLocation}=body;let builtMessages=[...(system?[{role:'system',content:system}]:[]),...(messages||[])];
+// ★ 2026-07-30 신설 — handleAIChat은 순수 패스스루라 UNIVERSAL 공통규칙조차
+// 안 붙는 경로다(school.html·stock.html 주석에 이미 같은 문제로 /deepseek로
